# Copy to supabase/.env.deploy and fill in. That file is gitignored.

# Any long random string. It is a shared secret between Supabase and
# RevenueCat and exists nowhere else, so invent it here and paste the same
# value into RevenueCat's webhook Authorization header as "Bearer <value>".
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(36))"
REVENUECAT_WEBHOOK_SECRET=

# RevenueCat -> Project settings -> API keys -> Secret key. Starts sk_.
# NOT the appl_ public SDK key, which is already in app/eas.json and is a
# different thing entirely.
REVENUECAT_SECRET_KEY=
