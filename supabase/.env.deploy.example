# Copy to supabase/.env.deploy and fill in. That file is gitignored.
# Used only by supabase/deploy.ps1. Never commit it, never paste it into chat.

# https://supabase.com/dashboard/account/tokens -> Generate new token
# Replaces `supabase login`, so the deploy needs no browser.
SUPABASE_ACCESS_TOKEN=

# Any long random string, at least 24 chars. It is a shared secret between
# Supabase and RevenueCat and exists nowhere else, so invent it here and paste
# the same value into RevenueCat's webhook Authorization header as
# "Bearer <value>".   python -c "import secrets; print(secrets.token_urlsafe(36))"
REVENUECAT_WEBHOOK_SECRET=

# RevenueCat -> Project settings -> API keys -> Secret key. Starts sk_.
# NOT the appl_ public SDK key, which is already in app/eas.json and is a
# completely different thing.
REVENUECAT_SECRET_KEY=
