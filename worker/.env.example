# Copy to worker/.env  —  worker/.env is gitignored.
#
# The worker connects with the SERVICE ROLE and bypasses RLS by design. It is
# the only component permitted to write fixtures, predictions and settled
# points. None of these values may ever reach the client (CLAUDE.md §2 [HARD]).

# Supabase -> Project Settings -> Database -> Connection string -> URI
# Use the SESSION POOLER string, not the direct connection, for cron jobs.
DATABASE_URL=postgresql://postgres.YOUR-REF:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

# https://www.football-data.org/client/register  (free tier: 10 req/min)
FOOTBALL_DATA_ORG_TOKEN=your-token

LOG_LEVEL=INFO
