# Copy to app/.env  —  app/.env is gitignored.
#
# CLAUDE.md §2 [HARD]: these two values are the ONLY things permitted to reach
# the JS bundle. Every EXPO_PUBLIC_* value is inlined verbatim and is trivially
# readable from a shipped app.
#
# The anon key is designed to be public. It grants exactly what RLS allows and
# nothing more — which is why supabase/migrations/0002_rls.sql is the security
# model, not a formality. If you are ever tempted to add a third variable here,
# it belongs in EAS secrets and behind an Edge Function instead.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional, for scripts/print-fixtures.ts
SEASON=2026-27
GAMEWEEK=1
